/*C5*/INSERT INTO ALERT VALUES(26,0,10010,'Cookie No HttpOnly Flag',1,2,'A cookie has been set without the HttpOnly flag, which means that the cookie can be accessed by JavaScript. If a malicious script can be run on this page then the cookie will be accessible and can be transmitted to another site. If this is a session cookie then session hijacking may be possible.','http://localhost:8085/prijava','SEARCH_SAMESITE','','Ensure that the HttpOnly flag is set for all cookies.','https://owasp.org/www-community/HttpOnly',28,28,'','Set-Cookie: SEARCH_SAMESITE',1004,13,3,'','http://localhost:8085/prijava ()(multipart:username,password,returnUrl)','10010')
